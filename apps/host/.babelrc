{
  "presets": [
    "@babel/preset-env",
    "@babel/preset-react",
    ["@babel/preset-typescript", { "isTSX": true, "allExtensions": true }]
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "root": ["./src"],
        "alias": {
          "shared": "../shared/src",
          "@shared-utils": "../../packages/shared-utils/src",
          "@shared-utils/*": "../../packages/shared-utils/src/*"
        }
      }
    ]
  ]
}
